+// the profile's a and b per channel, or the green entry for all three
+// channels, which is what the module did before per_channel_profile
+static void _profile_coeffs(const dt_iop_denoiseprofile_data_t *const d,
+                            dt_aligned_pixel_t a,
+                            dt_aligned_pixel_t b)
+{
+  for(int c = 0; c < 3; c++)
+  {
+    const int k = d->per_channel_profile ? c : 1;
+    a[c] = d->a[k];
+    b[c] = d->b[k];
+  }
+  a[3] = d->a[1];
+  b[3] = d->b[1];
+}
+
+// Y0U0V0 needs the same transform gain in all channels, or U0 and V0 stop
+// cancelling the signal (see set_up_conversion_matrices), so the
+// per-channel noise enters through the matrix: it treats wb as the noise
+// standard deviation of each channel, which scales with sqrt(a)
+static void _noise_weighted_wb(dt_aligned_pixel_t out,
+                               const dt_aligned_pixel_t wb,
+                               const dt_aligned_pixel_t a)
+{
+  for(int c = 0; c < 3; c++)
+    out[c] = wb[c] * sqrtf(a[c] / a[1]);
+  out[3] = wb[3];
+}
+
