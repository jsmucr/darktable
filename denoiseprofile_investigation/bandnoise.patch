+static int _cmp_float(const void *a, const void *b)
+{
+  const float x = *(const float *)a, y = *(const float *)b;
+  return (x > y) - (x < y);
+}
+
+// noise sigma per channel of a zero-mean detail band, from its flattest
+// parts: mean square per block, 10th percentile across blocks, so that
+// texture and edges do not count. Blocks grow with the scale, which keeps
+// the number of independent coefficients per block about constant. Leaves
+// sigma at 0 when the band is too small to measure.
+static void _band_noise(const float *const restrict detail,
+                        const int width,
+                        const int height,
+                        const int scale,
+                        dt_aligned_pixel_t sigma)
+{
+  for_each_channel(c) sigma[c] = 0.0f;
+  int bs = 16 << scale;
+  while(bs > 8 && (size_t)(width / bs) * (height / bs) < 64) bs /= 2;
+  const int bw = width / bs, bh = height / bs;
+  const size_t nb = (size_t)bw * bh;
+  if(nb < 16) return;
+
+  float *ms = dt_alloc_align_float(3 * nb);
+  if(!ms) return;
+  DT_OMP_FOR(collapse(2))
+  for(int by = 0; by < bh; by++)
+    for(int bx = 0; bx < bw; bx++)
+    {
+      double acc[3] = { 0.0, 0.0, 0.0 };
+      for(int y = by * bs; y < (by + 1) * bs; y++)
+      {
+        const float *row = detail + (size_t)4 * ((size_t)y * width + (size_t)bx * bs);
+        for(int x = 0; x < bs; x++)
+          for(int c = 0; c < 3; c++)
+            acc[c] += row[4 * x + c] * row[4 * x + c];
+      }
+      for(int c = 0; c < 3; c++)
+        ms[c * nb + (size_t)by * bw + bx] = acc[c] / ((double)bs * bs);
+    }
+  for(int c = 0; c < 3; c++)
+  {
+    qsort(ms + c * nb, nb, sizeof(float), _cmp_float);
+    sigma[c] = sqrtf(ms[c * nb + nb / 10]);
+  }
+  dt_free_align(ms);
 }
 
