+// renders match the full frame. Returns FALSE when not set
+static gboolean _band_noise_fixed(const int slot, dt_aligned_pixel_t sigma)
+{
+  const char *e = g_getenv("DT_DN_BNFIXED");
+  if(!e) return FALSE;
+  gchar **v = g_strsplit_set(e, " ,", -1);
+  const guint n = g_strv_length(v);
