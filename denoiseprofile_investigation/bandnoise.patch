+// INVESTIGATION ONLY: DT_DN_DUMP=<dir> DT_DN_CROP="x y w h" dumps a crop of
+// a 4-channel float buffer as PFM from the export pipe
+static void _inv_dump(const dt_dev_pixelpipe_iop_t *const piece,
+                      const dt_iop_roi_t *const roi,
+                      const char *const name,
+                      const float *const buf)
+{
+  const char *dir = g_getenv("DT_DN_DUMP");
+  const char *crop = g_getenv("DT_DN_CROP");
+  if(!dir || !crop || !dt_pipe_is_export(piece->pipe)) return;
+  int x0, y0, w, h;
+  if(sscanf(crop, "%d %d %d %d", &x0, &y0, &w, &h) != 4) return;
+  x0 -= roi->x;
+  y0 -= roi->y;
+  if(x0 < 0 || y0 < 0 || x0 + w > roi->width || y0 + h > roi->height)
+  {
+    fprintf(stderr, "[inv] %s: crop outside roi %d %d %dx%d\n", name,
+            roi->x, roi->y, roi->width, roi->height);
+    return;
+  }
+  float *tmp = dt_alloc_align_float((size_t)4 * w * h);
+  for(int j = 0; j < h; j++)
+    memcpy(tmp + (size_t)4 * w * j,
+           buf + (size_t)4 * ((size_t)(y0 + j) * roi->width + x0),
+           sizeof(float) * 4 * w);
+  char *fn = g_strdup_printf("%s/%s.pfm", dir, name);
+  dt_write_pfm(fn, w, h, tmp, 4 * sizeof(float));
+  g_free(fn);
+  dt_free_align(tmp);
+}
